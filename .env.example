# Per-machine overrides go in `.env.local` (gitignored).
# Sensible defaults live in `.env.development` and `.env.production` (committed).
#
# To run dev against a real local backend instead of mocks, copy this file to
# `.env.local` and set:
#
#   NEXT_PUBLIC_API_URL=http://localhost:4000
#   NEXT_PUBLIC_API_MOCKING=false
#
# Or to run dev against the deployed Render backend:
#
#   NEXT_PUBLIC_API_URL=https://salary-management-api-server.onrender.com
#   NEXT_PUBLIC_API_MOCKING=false

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_MOCKING=true
