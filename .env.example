# Copy this file to `.env` and adjust the values.
# Only one .env file is used — NODE_ENV picks between the DEV and PROD URLs.

NODE_ENV=development

# Local backend URL (used when NODE_ENV=development, i.e. `npm run dev`)
NEXT_PUBLIC_API_URL_DEV=http://localhost:4000

# Production backend URL (used when NODE_ENV=production, i.e. `npm run build`)
NEXT_PUBLIC_API_URL_PROD=https://salary-management-api-server.onrender.com

# Set to "true" to use in-browser MSW mocks instead of hitting a real backend.
# Mocking is automatically disabled in production builds.
NEXT_PUBLIC_API_MOCKING=true
